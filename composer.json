{
    "name": "units/ai",
    "description": "AI unit - ask, chat and tool calling over an injected provider, on the patterns/unit contract.",
    "type": "library",
    "keywords": [
        "ai",
        "unit",
        "llm",
        "openai",
        "claude",
        "gemini",
        "deepseek",
        "tool-calling",
        "dna",
        "provenance"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "patterns/unit": "^1.0.1",
        "patterns/event-channel": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "guzzlehttp/guzzle": "^7.10",
        "guzzlehttp/psr7": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Units\\Ai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Units\\Ai\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
